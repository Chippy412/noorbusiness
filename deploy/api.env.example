# deploy/api.env.example
# Copy to /etc/noorbusiness/api.env on the server (chmod 600, owner root).
# Fill in real values there only. Never commit the real file.

# Public address of the site (no trailing slash). Used for canonical links,
# the sitemap, emails.
SITE_URL=https://noorbusiness.org

# Self-hosted Supabase. The API talks to Kong directly on the server.
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# SUPABASE_AUTH_CAPTCHA=1

# Email alerts via Amazon SES (SES v2 HTTP API, signed in api/_lib/ses.js).
# The IAM user behind these keys needs only the ses:SendEmail permission.
# NOTIFY_EMAIL_FROM must be an address on a verified SES identity
# (e.g. NICC Business <alerts@noorbusiness.org>).
NOTIFY_SECRET=
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Rate-limit hashing salt (any long random string)
IP_HASH_SALT=

