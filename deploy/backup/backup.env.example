# deploy/backup/backup.env.example
# Copy to /etc/noorbusiness/backup.env (install.sh does), chmod 600, owner root.
# Fill in real values there only. Never commit the real file.

# --- Off-server copy (S3 bucket in the masjid's AWS account) ---
# Leave BACKUP_S3_URI empty to skip the upload (the backup then only exists on
# this server, which does NOT protect against losing the server).
BACKUP_S3_URI=s3://CHANGE-ME-bucket/noorbusiness
AWS_DEFAULT_REGION=us-east-1
# Lightsail has no instance role, so use a dedicated IAM user whose policy only
# allows s3:PutObject / s3:ListBucket / s3:GetObject on that bucket+prefix.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Local retention (optional; defaults shown) ---
# KEEP_DAILY=14
# KEEP_WEEKLY=8

# --- Alert emails via Amazon SES (used by healthcheck.sh and failed backup runs) ---
# A separate IAM user from the S3 one above; its policy only needs ses:SendEmail.
# Uses the `aws` CLI if installed, otherwise /opt/noorbusiness/api/_lib/ses.js.
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM must be an address on a verified SES identity (noorbusiness.org).
ALERT_EMAIL_FROM=

# --- Healthcheck thresholds (optional; defaults shown) ---
# DISK_MAX_PCT=85
# MEM_MIN_MB=300            # MemAvailable + SwapFree
# CERT_MIN_DAYS=14
# BACKUP_MAX_AGE_HOURS=36
# COMPOSE_PROJECT=supabase  # docker compose project name of /opt/supabase/docker
